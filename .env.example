# ==============================================================
# CV Processing Pipeline
# Environment Configuration
# ==============================================================


# ==============================================================
# Application
# ==============================================================

APP_NAME="CV Processing Pipeline"
APP_VERSION=0.1.0
ENVIRONMENT=development


# ==============================================================
# Logging
# ==============================================================

LOG_LEVEL=INFO


# ==============================================================
# LLM Provider
# ==============================================================

# OpenRouter is the primary provider.
#
# Allowed:
#   openrouter
#   ollama

LLM_PROVIDER=openrouter

LLM_TEMPERATURE=0.0

LLM_MAX_RETRIES=2

LLM_TIMEOUT_SECONDS=60

LLM_PARSE_RETRIES=2

LLM_MAX_OUTPUT_TOKENS=4096

LLM_CONTEXT_WINDOW=8192


# ==============================================================
# OpenRouter
# ==============================================================

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_MODEL=openai/gpt-oss-20b:free


# ==============================================================
# Ollama
# ==============================================================

# If Ollama runs on the HOST machine:
#
# Docker Desktop / Windows:
# http://host.docker.internal:11434
#
# If Ollama runs in another Docker container:
# http://ollama:11434

OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_MODEL=ministral-3:3b


# ==============================================================
# PostgreSQL
# ==============================================================

POSTGRES_DB=cv_pipeline

POSTGRES_USER=postgres

POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

POSTGRES_PORT=5432


# ==============================================================
# Application database URL
#
# IMPORTANT:
# Do NOT use localhost here when running inside Docker.
#
# docker-compose.yml automatically builds the correct URL
# using the PostgreSQL service name "postgres".
# ==============================================================

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_THIS_PASSWORD@postgres:5432/cv_pipeline


# ==============================================================
# API
# ==============================================================

API_PORT=8000


# ==============================================================
# Upload
# ==============================================================

MAX_UPLOAD_SIZE_MB=10